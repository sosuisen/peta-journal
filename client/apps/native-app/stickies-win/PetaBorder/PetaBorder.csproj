<Project Sdk="Microsoft.NET.Sdk">
  <!-- What the shell does without WinUI: the core behind its border, what one window shows, the
       keys, the text of an item as it is shown, and the file of the stickies. It has no WinUI
       in it, so "dotnet test" can test it. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>PetaBorder</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The projects under generated/ are made from the Rust crates by generate.ps1. -->
  <ItemGroup>
    <ProjectReference Include="..\generated\csharp\PetaTypes.csproj" />
    <ProjectReference Include="..\generated\PetaCore\BoltFFI.CSharp.csproj" />
    <!-- The core itself. The project of BoltFFI only packs it into its NuGet package, so it is
         copied from here to wherever this project is used. generate.sh makes it for the system
         that runs it: on a Mac, for the tests of this project. -->
    <Content
      Condition="$([MSBuild]::IsOSPlatform('Windows'))"
      Include="..\generated\PetaCore\runtimes\win-x64\native\client_shell_http.dll"
      Link="client_shell_http.dll"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Condition="$([MSBuild]::IsOSPlatform('OSX'))"
      Include="..\generated\PetaCore\runtimes\osx-arm64\native\libclient_shell_http.dylib"
      Link="libclient_shell_http.dylib"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PetaBorder.Tests" />
  </ItemGroup>
</Project>
