<Project>
  <!-- Settings for the hand-written projects under stickies-win. The projects under
       generated/ are made by tools, and their code is not held to these rules. -->
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Contains('generated'))">
    <!-- The analyzers of the .NET SDK, with the rules that Microsoft recommends. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Without this, a build at the command line skips the code style rules (IDExxxx). -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- A warning does not stop the build. The rules that must hold are errors, one by one.
         Not TreatWarningsAsErrors: it would also stop the build for rules nobody chose.
         "nullable" is the group of the null safety warnings of the compiler (CS86xx).
         CS8509 is a switch expression that leaves out a case: with Node a closed record, a
         kind of node that is not drawn (ADR 041). -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS8509</WarningsAsErrors>
  </PropertyGroup>
  <!-- The generated classes have no constructor. Deserialize fills every field, but the
       compiler warns for each field (CS8618), and for the key type of a map (CS8714).
       CS8618 is right about one thing: hand-written code can leave a field out, and then
       the field is null. But the warning points at the generated code, which is made again
       on every run of generate.ps1, so nobody can act on it here. About 120 of these hid
       the warnings of the hand-written code. Other warnings of the generated code still
       show. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('generated'))">
    <NoWarn>$(NoWarn);CS8618;CS8714</NoWarn>
  </PropertyGroup>
</Project>
