<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app: the windows of the stickies and the views in them. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>PetaStickies</RootNamespace>
    <!-- Only x64 is built: generate.ps1 builds the core for win-x64 only. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- No package: the app is a folder with an .exe in it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The Windows App SDK lies beside the .exe, so nothing has to be installed to run it. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetaBorder\PetaBorder.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>
</Project>
