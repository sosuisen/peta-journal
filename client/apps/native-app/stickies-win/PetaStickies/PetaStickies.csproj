<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app: it starts the stickies. Their windows are in PetaScreens (ADR 059). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>PetaStickies</RootNamespace>
    <!-- Only x64 is built: generate.ps1 builds the core for win-x64 only. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- No package: the app is a folder with an .exe in it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The Windows App SDK lies beside the .exe, so nothing has to be installed to run it. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Made by icon.ps1 from images/peta-journal.svg. -->
    <ApplicationIcon>PetaStickies.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetaBorder\PetaBorder.csproj" />
    <ProjectReference Include="..\PetaScreens\PetaScreens.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <!-- Beside the .exe for the windows, which take their icon from a file. -->
    <Content Include="PetaStickies.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
