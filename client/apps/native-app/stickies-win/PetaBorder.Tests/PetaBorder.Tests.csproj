<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>PetaBorder.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PetaBorder\PetaBorder.csproj" />
    <!-- xunit.v3 runs on Microsoft.Testing.Platform. The .NET SDK runs it with "dotnet test"
         only when global.json says so, and it looks for global.json from the current folder
         upward. So run "dotnet test" in this folder or in stickies-win. -->
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- "dotnet build -t:Coverage" runs the tests and measures the coverage of the lines of
       PetaBorder with coverlet.console, a local tool (dotnet-tools.json). Below 90% of the lines,
       it fails, and so does the CI. A line no test reaches is either removed, or given a test of
       the behaviour that needs it. The tests with the journal server need PETA_E2E_SERVER: a
       skipped test reaches no line.
       The projects under generated/ are made by tools. Not done yet (#1085): only PetaBorder is
       measured (include). PetaScreens and PetaStickies are not: their tests press real keys on
       the screen, and do not run in the CI yet. The whole app has to be measured, as the
       developer decided. scripts/verification.test.mjs guards these values. -->
  <Target Name="Coverage" DependsOnTargets="Build">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="dotnet coverlet &quot;$(TargetPath)&quot; --target dotnet --targetargs &quot;$(TargetPath)&quot; --include &quot;[PetaBorder]*&quot; --threshold 90 --threshold-type line --threshold-stat total --format cobertura --output coverage/"
    />
  </Target>
</Project>
