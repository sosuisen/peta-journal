<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>

    <RootNamespace>MemoView</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <FmAst2HtmlVersion>0.10.0</FmAst2HtmlVersion>
    <FmAst2HtmlUrl>https://unpkg.com/flatmarkdown-ast2html@$(FmAst2HtmlVersion)/dist/index.global.js</FmAst2HtmlUrl>
    <!-- The version is part of the file name. A new version is then a file that does not
         exist yet, and the build downloads it. -->
    <FmAst2HtmlJsName>fm-ast2html-$(FmAst2HtmlVersion).js</FmAst2HtmlJsName>
    <FmAst2HtmlJsPath>vendor\$(FmAst2HtmlJsName)</FmAst2HtmlJsPath>
  </PropertyGroup>

  <Target
    Name="DownloadFmAst2Html"
    BeforeTargets="BeforeCompile"
    Condition="!Exists('$(FmAst2HtmlJsPath)')"
  >
    <DownloadFile
      SourceUrl="$(FmAst2HtmlUrl)"
      DestinationFolder="vendor"
      DestinationFileName="$(FmAst2HtmlJsName)"
    />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(FmAst2HtmlJsPath)" LogicalName="fm-ast2html.js" />
    <EmbeddedResource Include="Web\page.css" LogicalName="page.css" />
    <EmbeddedResource Include="Web\page.js" LogicalName="page.js" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
  </ItemGroup>
</Project>
