<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MemoView.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The tests compile the source files of the app that do not use WinUI.
       They do not reference MemoView.csproj: that project is a WinUI program, and it builds
       only with the MSBuild of Visual Studio. This way, "dotnet test" is enough. -->
  <ItemGroup>
    <Compile Include="..\memoview\Models\ItemModel.cs" Link="App\Models\ItemModel.cs" />
    <Compile Include="..\memoview\Services\OutlineHtml.cs" Link="App\Services\OutlineHtml.cs" />
    <Compile Include="..\memoview\Services\PageHtml.cs" Link="App\Services\PageHtml.cs" />
    <Compile Include="..\memoview\Services\LinkTemplates.cs" Link="App\Services\LinkTemplates.cs" />
    <Compile
      Include="..\memoview\Services\SettingsService.cs"
      Link="App\Services\SettingsService.cs"
    />
    <Compile Include="..\memoview\Services\WebMessage.cs" Link="App\Services\WebMessage.cs" />
    <!-- The script of a page, to check that it sends the messages the app reads. -->
    <EmbeddedResource Include="..\memoview\Web\page.js" LogicalName="page.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform. The .NET 10 SDK runs it with "dotnet test"
         only when global.json says so, and it looks for global.json from the current folder
         upward. So run "dotnet test" in this folder. -->
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- "dotnet build -t:Coverage" runs the tests and measures the coverage of the lines with
       coverlet.console, a local tool (dotnet-tools.json). Below 90% of the lines of the app files
       together, it fails, and so does the CI. A line no test reaches is either removed, or given a
       test of the behaviour that needs it.
       Why coverlet.console: the app files are compiled into this test assembly, and the coverlet
       extension of Microsoft.Testing.Platform cannot measure the assembly that runs the tests.
       coverlet.console rewrites the assembly on disk before the tests start.
       The files of the tests are left out (exclude-by-file): only the files of the app count.
       Not done yet (#1086): only the files of the app compiled into this project are measured.
       The files with WinUI (MainWindow.xaml.cs, App.xaml.cs) and JournalApiService.cs are not.
       The whole app has to be measured, as the developer decided.
       scripts/verification.test.mjs guards these values. -->
  <Target Name="Coverage" DependsOnTargets="Build">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="dotnet coverlet &quot;$(TargetPath)&quot; --target dotnet --targetargs &quot;$(TargetPath)&quot; --include-test-assembly --exclude-by-file &quot;**/memoview-tests/**&quot; --threshold 90 --threshold-type line --threshold-stat total --format cobertura --output coverage/"
    />
  </Target>
</Project>
