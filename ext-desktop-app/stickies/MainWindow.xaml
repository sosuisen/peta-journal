<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Stickies.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Stickies">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="TitleBarRow" Grid.Row="0" Height="40" Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: New Window + Hamburger -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="NewWindowButton" Click="NewWindowButton_Click"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="New sticky window">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <Button x:Name="SearchButton" Click="SearchButton_Click"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Search pages">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- Center: Page Title -->
            <TextBlock x:Name="PageTitleText" Grid.Column="1"
                       Text="Stickies"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <!-- Right: Color menu + Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="MenuButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Background color">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Yellow" Tag="#FFFDD0" Click="ColorMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA3A;" Foreground="#FFFDD0" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Pink" Tag="#FFD1DC" Click="ColorMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA3A;" Foreground="#FFD1DC" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Green" Tag="#D0F0C0" Click="ColorMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA3A;" Foreground="#D0F0C0" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Blue" Tag="#D0E8FF" Click="ColorMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA3A;" Foreground="#D0E8FF" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="White" Tag="#FFFFFF" Click="ColorMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA3A;" Foreground="#FFFFFF" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="PinButton" Click="PinButton_Click"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Toggle always on top">
                    <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="14" />
                </Button>
                <Button x:Name="CloseButton" Click="CloseButton_Click"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Search Overlay Panel -->
            <Grid x:Name="SearchPanel" Visibility="Collapsed" Canvas.ZIndex="10">
                <Grid Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox" Grid.Row="0"
                             PlaceholderText="Search pages..."
                             Margin="8" TextChanged="SearchBox_TextChanged" />

                    <ListView x:Name="SearchResultsList" Grid.Row="1"
                              Margin="8,0,8,8"
                              SelectionMode="Single"
                              ItemClick="SearchResultsList_ItemClick"
                              IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PageTitle}" Padding="4,8" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- WebView2 -->
            <WebView2 x:Name="ContentWebView" />
        </Grid>
    </Grid>
</Window>
