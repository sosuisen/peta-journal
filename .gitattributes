# Auto detect text files and use LF for them, in the repository and in the working tree.
# Why eol=lf: without it, core.autocrlf=true (the default of Git for Windows) checks them out
# with CRLF, and the checks that read them line by line (scripts/*.test.mjs) fail
* text=auto eol=lf

# Force LF for shell scripts
*.sh text eol=lf

# Force CRLF for Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.so binary
*.dylib binary
*.jar binary
*.class binary
*.ttf binary
